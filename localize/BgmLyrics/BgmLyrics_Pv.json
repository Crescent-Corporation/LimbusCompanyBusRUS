{
  "dataList": [
    {
      "id": "0",
      "content": "…Тц."
    },
    {
      "id": "1",
      "content": "В путь-дорогу, врум-врум."
    },
    {
      "id": "2",
      "content": "Да, в самое пекло Ада."
    },
    {
      "id": "3",
      "content": "Прошёл по пути"
    },
    {
      "id": "4",
      "content": "Где прошлого дни"
    },
    {
      "id": "5",
      "content": "И с цепких ветвей"
    },
    {
      "id": "6",
      "content": "Сожалений друг, взят запретный плод"
    },
    {
      "id": "7",
      "content": "Кожуру надкусив\nВкушаю его я плоть"
    },
    {
      "id": "8",
      "content": "Испив и тёплый гной"
    },
    {
      "id": "9",
      "content": "Стал ты ненавистным столь “мной”"
    },
    {
      "id": "10",
      "content": "Отмотай же,\nвек наш поглотив"
    },
    {
      "id": "11",
      "content": "Горюй!\nДо́лжно ль жизнь мне дальше жить"
    },
    {
      "id": "12",
      "content": "До́лжно ль зло к себе простить"
    },
    {
      "id": "13",
      "content": "До́лжно ль нам игру продолжить, этичны будто мы"
    },
    {
      "id": "14",
      "content": "В смертельной петле\n(В смертельной петле)"
    },
    {
      "id": "15",
      "content": "Суждения наши\nИ щит — наше эго\nВ чём же наш грех?"
    },
    {
      "id": "16",
      "content": "Горюй!\nЧто же смыла муки смерть?"
    },
    {
      "id": "17",
      "content": "Что всем боль моя чужда?"
    },
    {
      "id": "18",
      "content": "Что ж жестоким водружают героев венец?"
    },
    {
      "id": "19",
      "content": "И в геенне сей\n(геенне сей)"
    },
    {
      "id": "20",
      "content": "Что все воздвигли мы"
    },
    {
      "id": "21",
      "content": "Вернём же жизнь в аду себе"
    }
  ]
}
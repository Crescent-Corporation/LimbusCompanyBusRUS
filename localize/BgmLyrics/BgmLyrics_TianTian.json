{
  "dataList": [
    {
      "id": 0,
      "content": "Сей день,"
    },
    {
      "id": 1,
      "content": "Тот день;"
    },
    {
      "id": 2,
      "content": "Рад дню за днём,"
    },
    {
      "id": 3,
      "content": "Но вечность не нужна"
    },
    {
      "id": 4,
      "content": "Что хмур,"
    },
    {
      "id": 5,
      "content": "Что светл,"
    },
    {
      "id": 6,
      "content": "Каким б ни был"
    },
    {
      "id": 7,
      "content": "День каждый всё же мил"
    },
    {
      "id": 8,
      "content": "Ла-ла, ла-лу,\nлу-ла,"
    },
    {
      "id": 9,
      "content": "Ту-ту-ту,\nту-ту, ту-ту…"
    },
    {
      "id": 10,
      "content": "<i>“Прив бабуль,\nты как там?”</i>"
    },
    {
      "id": 11,
      "content": "Ла-ла, ла-лу,\nлу-ла,"
    },
    {
      "id": 12,
      "content": "Ту-ту-ту,\nту-ту, ту-ту…"
    },
    {
      "id": 13,
      "content": "“Всё хорошо,\nба, пока!”"
    },
    {
      "id": 14,
      "content": "Верил всегда — не нужно всё,"
    },
    {
      "id": 15,
      "content": "Должен я лишь перетерпеть"
    },
    {
      "id": 16,
      "content": "Ко мне взор направь,"
    },
    {
      "id": 17,
      "content": "(Ла-лу-лу-ла,\nла-лу-лу-ла,\nха-ан)"
    },
    {
      "id": 18,
      "content": "Ведь век мой\nбудет краток и мил"
    },
    {
      "id": 19,
      "content": "(Лу-лу-лу, краток и мил)"
    },
    {
      "id": 20,
      "content": "Светл и нежен путь"
    },
    {
      "id": 21,
      "content": "(Ла-лу-лу-ла,\nла-лу-лу-ла,\nха-ан)"
    },
    {
      "id": 22,
      "content": "(Всё прямо, всё прямо)"
    },
    {
      "id": 23,
      "content": "Не забудем же"
    },
    {
      "id": 24,
      "content": "(Ла-лу-лу-ла,\nла-лу-лу-ла,\nха-ан)"
    },
    {
      "id": 25,
      "content": "Зовёт нас жизни торжество"
    },
    {
      "id": 26,
      "content": "(Лу-лу-лу, торжество)"
    },
    {
      "id": 27,
      "content": "Долго же не сиди"
    },
    {
      "id": 28,
      "content": "(Ла-лу-лу-ла,\nла-лу-лу-ла,\nха-ан)"
    },
    {
      "id": 29,
      "content": "(Ведь грубо, ведь грубо)"
    },
    {
      "id": 30,
      "content": "Рождёнными"
    },
    {
      "id": 31,
      "content": "Были добры"
    },
    {
      "id": 32,
      "content": "Когда-то схожие"
    },
    {
      "id": 33,
      "content": "Стали разны"
    },
    {
      "id": 34,
      "content": "В порядке,"
    },
    {
      "id": 35,
      "content": "Моу ман тай"
    },
    {
      "id": 36,
      "content": "Настал час"
    },
    {
      "id": 37,
      "content": "Это жизнь"
    },
    {
      "id": 38,
      "content": "ТЯНЬ ТЯНЬ"
    },
    {
      "id": 39,
      "content": "<i>“Прив, бабуль!\nНа днях случилось тако-ое,\nне поверишь!\nЯ всё-всё расскажу…”</i>"
    },
    {
      "id": 40,
      "content": "ТЯНЬ ТЯНЬ"
    },
    {
      "id": 41,
      "content": "<i>“Увидимся, ба!\nХотя, наверно, больше тебя\nи не увижу,\nхе-хе, правда?”</i>"
    },
    {
      "id": 42,
      "content": "Сей день,"
    },
    {
      "id": 43,
      "content": "Тот день;"
    },
    {
      "id": 44,
      "content": "Рад дню за днём,"
    },
    {
      "id": 45,
      "content": "Но вечность не нужна"
    },
    {
      "id": 46,
      "content": "Что хмур,"
    },
    {
      "id": 47,
      "content": "Что светл,"
    },
    {
      "id": 48,
      "content": "Каким б ни был"
    },
    {
      "id": 49,
      "content": "День каждый всё же мил"
    },
    {
      "id": 50,
      "content": "Не буду врать, что мне плевать"
    },
    {
      "id": 51,
      "content": "(Без мер)"
    },
    {
      "id": 52,
      "content": "Тяжесть приму всех дней, ночей"
    },
    {
      "id": 53,
      "content": "(Без мер)"
    },
    {
      "id": 54,
      "content": "Воздух столь свеж, вода чиста"
    },
    {
      "id": 55,
      "content": "(Без мер)"
    },
    {
      "id": 56,
      "content": "Сон куколок, для совок страх"
    },
    {
      "id": 57,
      "content": "(Вечность)"
    },
    {
      "id": 58,
      "content": "Быть может, и сбежим\nмы от смерти колесниц"
    },
    {
      "id": 59,
      "content": "Но в вечном беге нашем\nведь всех пейзажей не узреть"
    },
    {
      "id": 60,
      "content": "Надеюсь, сквозь глаза мои"
    },
    {
      "id": 61,
      "content": "Откроешь ты иной ответ"
    },
    {
      "id": 62,
      "content": "Из колодца в моём сердце\nлюбви не исчерпать"
    },
    {
      "id": 63,
      "content": "Ко мне взор направь"
    },
    {
      "id": 64,
      "content": "(Ла-лу-лу-ла,\nла-лу-лу-ла,\nха-ан)"
    },
    {
      "id": 65,
      "content": "Ведь век мой\nбудет краток и мил"
    },
    {
      "id": 66,
      "content": "(Лу-лу-лу, краток и мил)"
    },
    {
      "id": 67,
      "content": "Светл и нежен путь"
    },
    {
      "id": 68,
      "content": "(Ла-лу-лу-ла,\nла-лу-лу-ла,\nха-ан)"
    },
    {
      "id": 69,
      "content": "(Всё прямо, всё прямо)"
    },
    {
      "id": 70,
      "content": "Придёт моей смерти час"
    },
    {
      "id": 71,
      "content": "(Ла-лу-лу-ла,\nла-лу-лу-ла,\nха-ан)"
    },
    {
      "id": 72,
      "content": "Не завидуй моей тишине"
    },
    {
      "id": 73,
      "content": "(Лу, лу, лу, тишине)"
    },
    {
      "id": 74,
      "content": "С улыбкой на лице"
    },
    {
      "id": 75,
      "content": "(Ла-лу-лу-ла,\nла-лу-лу-ла,\nха-ан)"
    },
    {
      "id": 76,
      "content": "(В покое, в покое)"
    },
    {
      "id": 77,
      "content": "Рождёнными"

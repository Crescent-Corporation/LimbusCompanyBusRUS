      "personalityid": 10601,
      "voiceFile": 0,
      "teller": "Хун Лу",
      "dialog": "Думаю, я более чем справлюсь!",
      "usage": "(800101, HIGH), (800102, HIGH), (800104, HIGH), (800105, HIGH) "
    },
    {
      "id": 3,
      "personalityid": 10601,
      "voiceFile": 0,
      "teller": "Хун Лу",
      "dialog": "М-м, что же. Хорошо. Я исполню ваше указание.",

{
  "dataList": [
    {
      "id": "0",
      "content": "<style=\"den\">Может, ждал исход нас сей"
    },
    {
      "id": "1",
      "content": "<style=\"den\">Ведь решил остаться падшим"
    },
    {
      "id": "2",
      "content": "<style=\"den\"><size=20>Свет</size>"
    },
    {
      "id": "3",
      "content": "<style=\"den\"><size=20>Звезда</size>"
    },
    {
      "id": "4",
      "content": "<style=\"den\">И <size=20>глас</size>"
    },
    {
      "id": "5",
      "content": "<style=\"den\"><size=20>Мысль</size> порчена"
    },
    {
      "id": "6",
      "content": "<style=\"den\"><size=20>Коснись</size>"
    },
    {
      "id": "7",
      "content": "<style=\"den\"><size=20>Уста</size>"
    },
    {
      "id": "8",
      "content": "<style=\"den\">Грёз <size=20>искаженье</size>"
    },
    {
      "id": "9",
      "content": "<style=\"den\"><size=20>Волны</size>"
    },
    {
      "id": "10",
      "content": "<style=\"den\"><size=20>Родник</size>"
    },
    {
      "id": "11",
      "content": "<style=\"den\"><size=20>Кремень</size>"
    },
    {
      "id": "12",
      "content": "<style=\"den\">Жажду только <size=20>множат</size>"
    },
    {
      "id": "13",
      "content": "<style=\"den\">Тот плод"
    },
    {
      "id": "14",
      "content": "<style=\"den\">Тот <size=20>грех</size>"
    },
    {
      "id": "15",
      "content": "<style=\"den\">Святая матерь"
    },
    {
      "id": "16",
      "content": "<style=\"den\">Ведь я болен, <size=20>ведь я болен</size>"
    },
    {
      "id": "17",
      "content": "<style=\"den\">Тотчас захватила, <size=20>вновь породила</size> ты меня"
    },
    {
      "id": "18",
      "content": "<style=\"den\">Сквозь <size=20>тело</size> преступив"
    },
    {
      "id": "19",
      "content": "<style=\"den\">Вот, <size=20>светлый</size> лужок"
    },
    {
      "id": "20",
      "content": "<style=\"den\">Устроился в <size=20>кружок</size>"
    },
    {
      "id": "21",
      "content": "<style=\"den\">Кроюсь я в <size=20>шелках</size>"
    },
    {
      "id": "22",
      "content": "<style=\"den\">С <size=20>головы</size> до <size=20>пят</size>"
    },
    {
      "id": "23",
      "content": "<style=\"den\">И <size=20>внутри</size> теплясь, мечтал <size=20>как ты</size> быть <size=20>я</size>"
    },
    {
      "id": "24",
      "content": "<style=\"den\">Хоть нельзя вернуться вспять"
    },
    {
      "id": "25",
      "content": "<style=\"den\">Есть ли что же мне терять?"
    },
    {
      "id": "26",
      "content": "<style=\"den\"><size=20>Раскол</size>"
    },
    {
      "id": "27",
      "content": "<style=\"den\"><size=20>Небес</size>"
    },
    {
      "id": "28",
      "content": "<style=\"den\"><size=20>Земли</size>"
    },
    {
      "id": "29",
      "content": "<style=\"den\">Из<size=20>трещин</size> выпал я" 
    },
    {
      "id": "30",
      "content": "<style=\"den\"><size=20>Рождён</size>"
    },
    {
      "id": "31",
      "content": "<style=\"den\">В <size=20>яйце</size>"
    },
    {
      "id": "32",
      "content": "<style=\"den\">Свеж разрыв в <size=20>мембране</size>"
    },
    {
      "id": "33",
      "content": "<style=\"den\"><size=20>Клеть</size>"
    },
    {
      "id": "34",
      "content": "<style=\"den\"><size=20>Гниёт</size>"
    },
    {
      "id": "35",
      "content": "<style=\"den\">Вновь обращаясь в <size=20>пепел</size>"
    },
    {
      "id": "36",
      "content": "<style=\"den\"><size=20>Творец</size>"
    },
    {
      "id": "37",
      "content": "<style=\"den\"><size=20>Рубец</size>"
    },
    {
      "id": "38",
      "content": "<style=\"den\">Мыслящий <size=20>холст</size>"
    },
    {
      "id": "39",
      "content": "<style=\"den\">Бей же, бей же, бей скорлупку"
    },
    {
      "id": "40",
      "content": "<style=\"den\">О, бейся малый, разбивай же"
    },
    {
      "id": "41",
      "content": "<style=\"den\">Покажи мне, покажи"
    },
    {
      "id": "42",
      "content": "<style=\"den\">Слушай же, подломленный наш"
    },
    {
      "id": "43",
      "content": "<style=\"den\">О, нам горе,"
    },
    {
      "id": "44",
      "content": "<style=\"den\">Горе нам!"
    },
    {
      "id": "45",
      "content": "<style=\"den\">И <size=20>жизнь</size>, и <size=20>смерть</size>, <size=20>добро</size> и <size=20>зло</size>"
    },
    {
      "id": "46",
      "content": "<style=\"den\">Вечным будь <size=20>проклятье</size> то"
    },
    {
      "id": "47",
      "content": "<style=\"den\"><size=20>Веди</size>, веди, <size=20>веди</size>, пусти"
    },
    {
      "id": "48",
      "content": "<style=\"den\">Веди, <size=20>предай</size>, веди, <size=20>оставь</size>"
    },
    {
      "id": "49",
      "content": "<style=\"den\"><size=20>Сокрой, раскрой, не верь, и впредь</size>"
    },
    {
      "id": "50",
      "content": "<style=\"den\"><size=20>Призыв и зов, Шифр сей читай</size>"
    },
    {
      "id": "51",
      "content": "<style=\"den\">О, нам горе,"
    },
    {
      "id": "52",
      "content": "<style=\"den\"><size=20>Горе нам!</size>"
    },
    {
      "id": "53",
      "content": "<style=\"den\"><size=20>Жизнь прошлую</size> в неполных <size=20>землях святости</size> оставь"
    },
    {
      "id": "54",
      "content": "<style=\"den\">Небесны"
    },
    {
      "id": "55",
      "content": "<style=\"den\">Ай-ийя"
    },
    {
      "id": "56",
      "content": "<style=\"den\">Астральны"
    },
    {
      "id": "57",
      "content": "<style=\"den\">Ай-ийю"
    },
    {
      "id": "58",
      "content": "<style=\"den\">Перерожусь"
    },
    {
      "id": "59",
      "content": "<style=\"den\">Le rheaiah"
    },
    {
      "id": "60",
      "content": "<style=\"den\">И освобожусь"
    },
    {
      "id": "61",
      "content": "<style=\"den\">Katre o lamenta"
    },
    {
      "id": "62",
      "content": "<style=\"den\">Сколь хрупок я"
    },
    {
      "id": "63",
      "content": "<style=\"den\">Рожденья песнь"
    },
    {
      "id": "64",
      "content": "<style=\"den\">Основа"
    },
    {
      "id": "65",
      "content": "<style=\"den\">Вдохнув,"
    },
    {
      "id": "66",
      "content": "<style=\"den\">Конечна"
    },
    {
      "id": "67",
      "content": "<style=\"den\">Вскричал"
    },
    {
      "id": "68",
      "content": "<style=\"den\">И вечна"
    },
    {
      "id": "69",
      "content": "<style=\"den\">Свой первый крик"
    },
    {
      "id": "70",
      "content": "<style=\"den\">Дух свобода всегда ждёт"
    }
  ]
}
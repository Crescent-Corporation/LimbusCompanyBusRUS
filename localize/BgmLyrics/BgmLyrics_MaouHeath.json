{
  "dataList": [
    {
      "id": 0,
      "content": "<style=\"den_CP6_2\">Как же я жаждал иного,",
      "vocalid": 0
    },
    {
      "id": 1,
      "content": "<style=\"den_CP6_2\">Света, счастья, ясного завтра",
      "vocalid": 0
    },
    {
      "id": 2,
      "content": "<style=\"den_CP6_2\">Вот он я, предо мной врата",
      "vocalid": 0
    },
    {
      "id": 3,
      "content": "<style=\"den_CP6_2\">Время шло,",
      "vocalid": 0
    },
    {
      "id": 4,
      "content": "<style=\"den_CP6_2\">Наконец решился я",
      "vocalid": 0
    },
    {
      "id": 5,
      "content": "<style=\"den_CP6_2\">Много же боли принёс я тебе гневом,",
      "vocalid": 0
    },
    {
      "id": 6,
      "content": "<style=\"den_CP6_2\">И грубой, неловкой натурой",
      "vocalid": 0
    },
    {
      "id": 7,
      "content": "Сколько же прелести своей ты не видишь",
      "vocalid": 1
    },
    {
      "id": 8,
      "content": "Силу и живость в манерах",
      "vocalid": 1
    },
    {
      "id": 9,
      "content": "<style=\"den_CP6_2\">Вот он наш судьбоносный час,",
      "vocalid": 0
    },
    {
      "id": 10,
      "content": "<style=\"den_CP6_2\">Покончу с ним для нас.",
      "vocalid": 0
    },
    {
      "id": 11,
      "content": "Мою кончину узришь?",
      "vocalid": 1
    },
    {
      "id": 12,
      "content": "<style=\"den_CP6_2\">О-о,",
      "vocalid": 0
    },
    {
      "id": 13,
      "content": "<style=\"den_CP6_2\">Вновь по той тропе,",
      "vocalid": 0
    },
    {
      "id": 14,
      "content": "<style=\"den_CP6_2\">Цепляемся за боль",
      "vocalid": 0
    },
    {
      "id": 15,
      "content": "<style=\"den_CP6_2\">С гордынею в душе",
      "vocalid": 0
    },
    {
      "id": 16,
      "content": "<style=\"den_CP6_2\">Чувства сокрыв,",
      "vocalid": 0
    },
    {
      "id": 17,
      "content": "<style=\"den_CP6_2\">Вертим в голове свои былые дни",
      "vocalid": 0
    },
    {
      "id": 18,
      "content": "<style=\"den_CP6_2\">Тебе ведь не понять,",
      "vocalid": 0
    },
    {
      "id": 19,
      "content": "<style=\"den_CP6_2\">Но знаю",
      "vocalid": 0
    },
    {
      "id": 20,
      "content": "<style=\"den_CP6_2\">Только по моей вине",
      "vocalid": 0
    },
    {
      "id": 21,
      "content": "<style=\"den_CP6_2\">Лик твой больше не игрив",
      "vocalid": 0
    },
    {
      "id": 22,
      "content": "<style=\"den_CP6_2\">И надежды перелив в очах утрачен",
      "vocalid": 0
    },
    {
      "id": 23,
      "content": "<style=\"den_CP6_2\">Только по моей вине",
      "vocalid": 0
    },
    {
      "id": 24,
      "content": "<style=\"den_CP6_2\">Лгать ты продолжаешь мне",
      "vocalid": 0
    },
    {
      "id": 25,
      "content": "<style=\"den_CP6_2\">Желаю жить день ото дня, забыв всё про меня",
      "vocalid": 0
    },
    {
      "id": 26,
      "content": "<style=\"den_CP6_2\">И сюжет сей уже был рассказан лиловой дымкою",
      "vocalid": 0
    },
    {
      "id": 27,
      "content": "<style=\"den_CP6_2\">Сколь разными же мы стали",
      "vocalid": 0
    },
    {
      "id": 28,
      "content": "<style=\"den_CP6_2\">Здравствуй",
      "vocalid": 0
    },
    {
      "id": 29,
      "content": "Ночи",
      "vocalid": 1
    },
    {
      "id": 30,
      "content": "<style=\"den_CP6_2\">Прощай",
      "vocalid": 0
    },
    {
      "id": 31,
      "content": "Здравствуй",
      "vocalid": 1
    },
    {
      "id": 32,
      "content": "<style=\"den_CP6_2\">Ночи",
      "vocalid": 0
    },
    {
      "id": 33,
      "content": "Я здесь",
      "vocalid": 1
    },
    {
      "id": 34,
      "content": "<style=\"den_CP6_2\">Прощай",
      "vocalid": 0
    },
    {
      "id": 35,
      "content": "Всё жду",
      "vocalid": 1
    },
    {
      "id": 36,
      "content": "<style=\"den_CP6_2\">Вот пред нами последний шанс",
      "vocalid": 0
    },
    {
      "id": 37,
      "content": "<style=\"den_CP6_2\">И рукой",
      "vocalid": 0
    },
    {
      "id": 38,
      "content": "<style=\"den_CP6_2\">Что жаждешь, соверши",
      "vocalid": 0
    },
    {
      "id": 39,
      "content": "<style=\"den_CP6_2\">Сотри",
      "vocalid": 0
    },
    {
      "id": 40,
